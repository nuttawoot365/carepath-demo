# คัดลอกเป็น .env ก่อนรัน docker compose
POSTGRES_DB=carepath
POSTGRES_USER=carepath_app
POSTGRES_PASSWORD=carepath_dev
DB_PORT=5433

API_PORT=3000
WEB_PORT=5173

# demo = เปิดนาฬิกาจำลองและ endpoint รีเซ็ต · production = ปิด
NODE_ENV=demo
JWT_SECRET=change-me-in-production
PUBLIC_BASE_URL=http://localhost:5173

# บนเครื่อง (ไม่ผ่าน docker) Next.js ต้องรู้ว่า NestJS อยู่ที่ไหน
# API_ORIGIN=http://localhost:3000
